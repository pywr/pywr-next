{
  "format": "v1",
  "base_model": "models/base.json",
  "dependencies": [
    {
      "name": "neighbour",
      "manifest": "../neighbour/pywr-project.json"
    }
  ],
  "sub_networks": [
    {
      "name": "catchment",
      "network_sets": [
        {
          "name": "inflows",
          "min": 1,
          "max": 1
        }
      ]
    }
  ],
  "network_sets": [
    {
      "name": "options"
    }
  ],
  "networks": [
    {
      "name": "historical",
      "description": "Historical catchment inflows.",
      "base": "catchment",
      "include": [
        {
          "set": "catchment::inflows",
          "files": [
            "historical.json"
          ]
        }
      ]
    },
    {
      "name": "stochastic",
      "description": "Stochastic catchment inflows.",
      "base": "catchment",
      "include": [
        {
          "set": "catchment::inflows",
          "files": [
            "stochastic.json"
          ]
        }
      ]
    },
    {
      "name": "option1",
      "description": "Supply option 1, feeding the demand directly.",
      "include": [
        {
          "set": "options",
          "files": [
            "option1.json"
          ]
        }
      ]
    },
    {
      "name": "option2",
      "description": "Supply option 2, feeding the link.",
      "include": [
        {
          "set": "options",
          "files": [
            "option2.json"
          ]
        }
      ]
    },
    {
      "name": "option12",
      "description": "Both supply options.",
      "extends": [
        "option1",
        "option2"
      ]
    }
  ],
  "models": [
    {
      "name": "baseline-historical",
      "networks": [
        "historical"
      ]
    },
    {
      "name": "baseline-stochastic",
      "networks": [
        "stochastic"
      ]
    },
    {
      "name": "baseline-option1",
      "networks": [
        "historical",
        "option1"
      ]
    },
    {
      "name": "baseline-option2",
      "networks": [
        "historical",
        "option2"
      ]
    },
    {
      "name": "baseline-option12",
      "networks": [
        "historical",
        "option12"
      ]
    }
  ],
  "multi_models": [
    {
      "name": "joint-historical",
      "domain": {
        "model": "baseline-historical"
      },
      "networks": [
        {
          "name": "company",
          "network": {
            "model": "baseline-historical"
          }
        },
        {
          "name": "neighbour",
          "network": {
            "network": "neighbour::neighbour"
          },
          "transfers": [
            {
              "from_network": "company",
              "metric": {
                "type": "Node",
                "name": "link1"
              },
              "name": "company-link1-flow",
              "initial_value": 0.0
            }
          ]
        }
      ]
    }
  ]
}
