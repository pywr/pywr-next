{
  "format": "v1",
  "base_model": "models/base.json",
  "network_sets": [
    {
      "name": "options"
    },
    {
      "name": "catchments",
      "min": 1,
      "max": 1
    }
  ],
  "networks": [
    {
      "name": "historical",
      "description": "Historical catchment inflows.",
      "include": [
        {
          "set": "catchments",
          "files": [
            "historical.json"
          ]
        }
      ]
    },
    {
      "name": "stochastic",
      "description": "Stochastic catchment inflows.",
      "include": [
        {
          "set": "catchments",
          "files": [
            "stochastic.json"
          ]
        }
      ]
    },
    {
      "name": "option1",
      "description": "Supply option 1, feeding the demand directly.",
      "include": [
        {
          "set": "options",
          "files": [
            "option1.json"
          ]
        }
      ]
    },
    {
      "name": "option2",
      "description": "Supply option 2, feeding the link.",
      "include": [
        {
          "set": "options",
          "files": [
            "option2.json"
          ]
        }
      ]
    },
    {
      "name": "option12",
      "description": "Both supply options.",
      "extends": [
        "option1",
        "option2"
      ]
    }
  ],
  "models": [
    {
      "name": "baseline-historical",
      "networks": [
        "historical"
      ]
    },
    {
      "name": "baseline-stochastic",
      "networks": [
        "stochastic"
      ]
    },
    {
      "name": "baseline-option1",
      "networks": [
        "historical",
        "option1"
      ]
    },
    {
      "name": "baseline-option2",
      "networks": [
        "historical",
        "option2"
      ]
    },
    {
      "name": "baseline-option12",
      "networks": [
        "historical",
        "option12"
      ]
    }
  ]
}
